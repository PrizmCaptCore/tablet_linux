out/
__pycache__/
*.pyc

# Device-unique data must never be committed: partition backups (IMEI/EFS, FRP, calibration,
# MACs) live outside the repo ([build] backup in config.toml), and boot/bootloader logs
# carry the serial number.
backup/
secrets/
logs/
*.img

# Python packaging byproducts
build/
*.egg-info/

# per-machine tbctl settings (template: config.example.toml)
config.toml

# tablet login (ID=, PW=) read by tbctl
.env