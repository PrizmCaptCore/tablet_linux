#!/bin/bash
# Switch between game mode (gamescope + Steam) and the GNOME desktop. Steam's "Switch to
# Desktop" runs `steamos-session-select plasma`; the desktop's "Return to Game Mode" runs
# `steamos-session-select gamescope`. SDDM logs straight into the chosen session (Relogin=true).
# After CachyOS gamescope-session 1.1.6 (MIT, from Valve's SteamOS gamescope-session).
set -e

GAMESCOPE=gamescope-session.desktop
DESKTOP=gnome.desktop

case "$1" in
    persistent)
        # boot into whichever session was used last
        systemctl --user mask tb138fc-gamescope-autologin.service
        pkexec /usr/local/lib/steamos/steam-set-session "$DESKTOP";;
    oneshot)
        # every fresh boot starts in game mode (default)
        systemctl --user unmask tb138fc-gamescope-autologin.service
        pkexec /usr/local/lib/steamos/steam-set-session "$GAMESCOPE";;
    gamescope)
        pkexec /usr/local/lib/steamos/steam-set-session "$GAMESCOPE"
        gnome-session-quit --logout --no-prompt;;
    plasma|desktop|gnome)
        pkexec /usr/local/lib/steamos/steam-set-session "$DESKTOP"
        "$HOME/.local/share/Steam-arm64/steamrtarm64/steam" -shutdown || true
        systemctl --user stop gamescope-session.target;;
    *)
        [[ -n "$1" ]] && echo -e "Unknown session '$1'\n"
        cat <<EOF
Usage: $(basename "$0") <mode>

  gamescope    switch to game mode now (Steam Big Picture on gamescope)
  plasma       switch to the GNOME desktop now (what Steam's "Switch to Desktop" runs)
  oneshot      every fresh boot starts in game mode (default)
  persistent   boot into the session used last
EOF
        exit 1;;
esac
