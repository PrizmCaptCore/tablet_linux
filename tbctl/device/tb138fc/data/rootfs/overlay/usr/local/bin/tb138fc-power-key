#!/usr/bin/env python3
"""Power key, phone style: a short press locks the session and turns the screen off (a second
press turns it on, at the lock screen), holding it opens GNOME's power-off dialog. In game mode
(gamescope session) both presses go to Steam, as SteamOS's power button handler does. GNOME's own handling is set to 'nothing' (dconf
10-tb138fc-power-key), so this service owns the key; system sleep is not available anyway.
"""
import glob
import os
import select
import struct
import subprocess
import sys
import time

DEVICE_NAME = "pm8941_pwrkey"
EV_KEY, KEY_POWER = 1, 116
LONG_PRESS = 1.0                      # seconds held before the power-off dialog opens
EVENT = struct.Struct("llHHi")        # struct input_event on 64-bit: time, type, code, value
SCREEN_ON, SCREEN_OFF = 0, 3          # org.gnome.Mutter.DisplayConfig PowerSaveMode
FAKE_SUSPEND_FLAG = "/run/tb138fc-fake-suspend"


def find_device():
    for name in glob.glob("/sys/class/input/event*/device/name"):
        with open(name) as f:
            if f.read().strip() == DEVICE_NAME:
                return "/dev/input/" + name.split("/")[4]
    sys.exit(f"no {DEVICE_NAME} input device")


def active_session():
    """(user, uid) of the active session on seat0: the logged-in user, or GDM's greeter."""
    def show(*args):
        return subprocess.run(["loginctl", *args, "--value"], capture_output=True,
                              text=True).stdout.split()
    sid = show("show-seat", "seat0", "-p", "ActiveSession")
    if not sid:
        return None
    info = show("show-session", sid[0], "-p", "Name", "-p", "User")
    return (info[1], info[0]) if len(info) == 2 else None


def gdbus(*args, timeout=5):
    """Call a method on the active session's bus; the reply text, or "" (no session, error,
    or no reply within `timeout` seconds)."""
    session = active_session()
    if session is None:
        return ""
    user, uid = session
    try:
        return subprocess.run(
            ["runuser", "-u", user, "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
             "gdbus", "call", "--session", "--timeout", str(timeout), *args],
            capture_output=True, text=True, timeout=timeout + 5).stdout
    except subprocess.TimeoutExpired:
        return ""


def steam_power_press(kind):
    """Game mode: hand the press to Steam the way SteamOS's power button handler does
    (steam://shortpowerpress sleeps, steam://longpowerpress opens the power menu). True when a
    gamescope session runs Steam."""
    session = active_session()
    if session is None:
        return False
    user, uid = session
    home = os.path.expanduser(f"~{user}")
    steam = f"{home}/.local/share/Steam-arm64/steamrtarm64/steam"
    if not (os.path.exists(f"/run/user/{uid}/gamescope-environment") and os.access(steam, os.X_OK)):
        return False
    try:
        # the client finds the running instance through ~/.steam, so HOME must be the user's
        subprocess.run(["runuser", "-u", user, "--", "env", f"HOME={home}", steam, "-ifrunning",
                        f"steam://{kind}powerpress"],
                       cwd=os.path.dirname(os.path.dirname(steam)), capture_output=True, timeout=20)
    except subprocess.TimeoutExpired:
        pass
    return True


def toggle_screen():
    display = ["--dest", "org.gnome.Mutter.DisplayConfig", "--object-path", "/org/gnome/Mutter/DisplayConfig",
               "--method"]
    mode = gdbus(*display, "org.freedesktop.DBus.Properties.Get", "org.gnome.Mutter.DisplayConfig",
                 "PowerSaveMode")
    if not mode.strip():
        return      # no GNOME session (game mode: Steam handles the key, see tb138fc-fake-suspend)
    target = SCREEN_ON if "<0>" not in mode else SCREEN_OFF
    if target == SCREEN_OFF:
        # Lock() (SetActive only raises the shield, swipeable without a password); gnome-shell
        # locks at once but does not answer the call, so do not wait for the reply. No-op at the
        # GDM greeter. The pause lets the lock screen come up before blanking.
        gdbus("--dest", "org.gnome.ScreenSaver", "--object-path", "/org/gnome/ScreenSaver",
              "--method", "org.gnome.ScreenSaver.Lock", timeout=1)
        time.sleep(0.5)
    gdbus(*display, "org.freedesktop.DBus.Properties.Set", "org.gnome.Mutter.DisplayConfig",
          "PowerSaveMode", f"<int32 {target}>")


def power_dialog():
    # wake the screen first, so the dialog is visible
    gdbus("--dest", "org.gnome.Mutter.DisplayConfig", "--object-path", "/org/gnome/Mutter/DisplayConfig",
          "--method", "org.freedesktop.DBus.Properties.Set", "org.gnome.Mutter.DisplayConfig",
          "PowerSaveMode", f"<int32 {SCREEN_ON}>")
    gdbus("--dest", "org.gnome.SessionManager", "--object-path", "/org/gnome/SessionManager",
          "--method", "org.gnome.SessionManager.Shutdown")


def main():
    fd = os.open(find_device(), os.O_RDONLY)
    pressed = False
    while True:
        # while the key is held, wait at most LONG_PRESS for its release
        ready, _, _ = select.select([fd], [], [], LONG_PRESS if pressed else None)
        if not ready:
            pressed = False
            if not steam_power_press("long"):
                power_dialog()
            continue
        for off in range(0, len(data := os.read(fd, EVENT.size * 16)), EVENT.size):
            _, _, etype, code, value = EVENT.unpack_from(data, off)
            if etype != EV_KEY or code != KEY_POWER:
                continue
            if os.path.exists(FAKE_SUSPEND_FLAG):
                pressed = False            # this press wakes the panel (tb138fc-fake-suspend)
                continue
            if value == 1:
                pressed = True
            elif value == 0 and pressed:       # released before LONG_PRESS
                pressed = False
                if not steam_power_press("short"):
                    toggle_screen()


if __name__ == "__main__":
    main()
