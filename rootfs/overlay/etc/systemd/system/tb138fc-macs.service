[Unit]
Description=Set the Wi-Fi address from the fpinfo partition
# the script exits quietly without fpinfo, so wait for its device node (raced at boot)
Requires=dev-disk-by\x2dpartlabel-fpinfo.device
After=dev-disk-by\x2dpartlabel-fpinfo.device local-fs.target
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tb138fc-macs wifi

[Install]
WantedBy=multi-user.target
