# TB138FC kernel configuration, merged onto arm64 defconfig (tbctl kernel build).
# Every value here is checked after olddefconfig: a symbol dropped by an unmet dependency
# fails the build instead of producing a kernel that cannot boot.

# ---- built in: everything the initramfs needs before modules are available
CONFIG_PINCTRL_SM8250=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_U_ETHER=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_CORE=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y
CONFIG_INPUT_EVDEV=y
CONFIG_TYPEC=y
CONFIG_DRM_AUX_BRIDGE=y
# (DRM_AUX_HPD_BRIDGE has no prompt: it follows the drivers that select it, here =m)
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
# the RTC holds the clock base for tb138fc-rtc, which runs in early boot
CONFIG_RTC_DRV_PM8XXX=y

# ---- modules
# Must NOT be built in: probing it reprograms the display PLL and freezes the panel
# (it is loaded later together with msm, which then drives the panel itself).
CONFIG_SM_DISPCC_8250=m
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_RAYDIUM_RM692H0=m
CONFIG_SND_SOC_CS35L43_I2C=m
CONFIG_SND_SOC_SM8250=m
# PM8150B SMB5 via the qcom_smbx SMB5 series
CONFIG_CHARGER_QCOM_SMB2=m
# BlueZ HID-over-GATT (BLE keyboards/mice) needs /dev/uhid
CONFIG_UHID=m
# Bluetooth hands-free/headset (HFP/HSP) and PAN tethering
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# ---- misc
# Landlock: pacman's download sandbox needs it
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-tb138fc"
